rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function isMasterAdmin() { 
      return isSignedIn() && 
             request.auth.token.email.matches('(?i)dalinadjib1990@gmail\\.com');
    }
    
    function isAdmin() { 
      return isMasterAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // ===============================================================
    // ENTITY VALIDATORS
    // ===============================================================
    
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.firstName is string && data.firstName.size() <= 50
        && data.lastName is string && data.lastName.size() <= 50
        && (!('role' in data) || data.role in ['user', 'admin'])
        && (!('isVerified' in data) || data.isVerified is bool);
    }

    function isValidAd(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.price is number && data.price >= 0
        && data.brand is string && data.model is string
        && data.status in ['active', 'sold'];
    }

    function isValidChat(data) {
      return data.participants is list 
        && data.participants.size() == 2
        && request.auth.uid in data.participants;
    }

    function isValidMessage(data) {
      return (data.senderId == request.auth.uid || data.senderId == 'AI_EXPERT')
        && data.text is string && data.text.size() <= 2000
        && data.chatId is string;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if true;
      allow update: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin() || true;
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    match /chats/{chatId} {
      allow read, create, update, delete: if true;
    }

    match /messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    match /security_events/{eventId} {
      // Allow reading and listening to security alerts
      allow read, list: if true;
      // Allow creation of security events if signed in or system logger
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
